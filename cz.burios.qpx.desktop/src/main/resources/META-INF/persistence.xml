<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">
    <persistence-unit name="archer" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <non-jta-data-source>java:comp/env/jdbc/JPADataSource</non-jta-data-source>
        <class>cz.burios.qpx.darwin.model.FileStore</class>
        <class>cz.burios.qpx.darwin.model.FileStoreRecord</class>
        <properties><property name="hibernate.hbm2ddl.auto" value="none"/></properties>
    </persistence-unit>
</persistence>
